---
import '@fontsource-variable/cinzel';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import cinzelUrl from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import TempleMark from '../components/site/TempleMark.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  intro?: boolean;
  published?: string;
  modified?: string;
}
const { title, description = '', image = '/media/og.jpg', type = 'website', noindex = false, intro = false, published, modified } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image, site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: site.url,
  telephone: '+447932259704',
  email: site.email,
  areaServed: 'Cheshire',
  address: { '@type': 'PostalAddress', addressRegion: 'Cheshire', addressCountry: 'GB' },
  logo: new URL('/brand/logo-full-white.svg', site.url).href,
  sameAs: [site.social.facebook, site.social.instagram],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0c0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={cinzelUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <slot name="head" />
    <script is:inline define:vars={{ intro }}>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (sessionStorage.getItem('rmc:pt')) h.classList.add('pt-arrive');
          // The homepage intro plays once per visit, never after an in-site page change.
          if (intro && !reduced && !sessionStorage.getItem('rmc:pt') && !sessionStorage.getItem('rmc:intro') && !/[?&]nointro\b/.test(location.search)) h.classList.add('intro-on');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="cursor" id="cursor" aria-hidden="true"><span class="cursor__ring"></span><span class="cursor__dot"></span></div>
    <div class="pt" id="pt" aria-hidden="true"><TempleMark /></div>
    <script>
      import '../scripts/core.js';
    </script>
  </body>
</html>
