---
// The temple from the client's logo, reduced to its main strokes (pediment, entablature, two fluted
// columns, three steps). Geometry is copied from the logo file; used as a small mark only.
const { class: className = '', title = '' } = Astro.props;
const flutes = [22.1, 27.7, 33.3, 38.9, 44.5, 50.1, 55.7];
---
<svg class={className} viewBox="0 0 288.4 230" fill="currentColor" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  <path d="M287.3 37.7H1l-.6-5L143.6 0h1.1l143.2 32.8-.6 4.9ZM23.4 32.7h241.6L144.2 5.1 23.4 32.7Z" fill-rule="evenodd" />
  <rect x="3.8" y="41.1" width="280.7" height="5.1" />
  <rect x="6.6" y="49" width="275.1" height="5.1" />
  <rect x="10" y="60" width="60.6" height="9" />
  <rect x="217.7" y="60" width="60.6" height="9" />
  <rect x="16.4" y="77" width="47.7" height="2.8" />
  <rect x="224.2" y="77" width="47.7" height="2.8" />
  {flutes.map((x) => <rect x={x} y="82.7" width="2.8" height="101.1" />)}
  {flutes.map((x) => <rect x={x + 207.7} y="82.7" width="2.8" height="101.1" />)}
  <rect x="16.4" y="186.5" width="47.7" height="2.8" />
  <rect x="224.2" y="186.5" width="47.7" height="2.8" />
  <rect x="10.8" y="192.1" width="58.9" height="2.8" />
  <rect x="218.5" y="192.1" width="58.9" height="2.8" />
  <rect x="6.6" y="202.2" width="275.1" height="5.1" />
  <rect x="3.8" y="213.5" width="280.7" height="5.1" />
  <rect x="1" y="224.7" width="286.3" height="5.1" />
</svg>
