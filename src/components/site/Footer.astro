---
import { site, nav } from '../../data/site';
---
<footer class="ftr is-dark" data-header-theme="dark">
  <div class="wrap ftr__in">
    <a class="ftr__logo" href="/" aria-label={`${site.name}: home`}>
      <img src="/brand/logo-full-white.svg" width="288" height="314" alt={site.name} loading="lazy" decoding="async" />
    </a>
    <div class="ftr__cols">
      <div>
        <h2 class="label ftr__h">Quick Links</h2>
        <ul>{nav.filter((n) => n.label !== 'Blog').map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/blog">Blog</a></li></ul>
      </div>
      <div>
        <h2 class="label ftr__h">Useful Links</h2>
        <ul>
          <li><a href="/cookie-policy">Cookie Policy</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>
      <div>
        <h2 class="label ftr__h">Contact Info</h2>
        <ul class="ftr__contact">
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.location}</li>
        </ul>
        <div class="ftr__social">
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.6-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.900 1.4-3.900 4v2.200H8v3h2.500V21h3Z"/></svg>
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap ftr__base">
    <p>{site.copyright}</p>
    <button class="label ftr__top" type="button" data-top>Back to top</button>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--line-dark); padding-top: clamp(3.5rem, 7vw, 6rem); }
  .ftr__in { display: grid; gap: 3rem; }
  .ftr__logo img { width: clamp(9rem, 16vw, 13rem); height: auto; }
  .ftr__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 1.5rem; }
  .ftr__cols > div:last-child { grid-column: 1 / -1; }
  .ftr__h { color: var(--on-dark-mute); margin-bottom: 1.1rem; font-weight: 400; }
  .ftr ul { display: grid; gap: 0.15rem; }
  .ftr li a { display: inline-block; padding-block: 0.35rem; background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.3rem) / 0% 1px no-repeat; transition: background-size var(--dur-2) var(--ease-out), color var(--dur-1); }
  .ftr li a:hover { background-size: 100% 1px; color: var(--brick-lit); }
  .ftr__contact li { padding-block: 0.1rem; overflow-wrap: anywhere; font-size: 0.95rem; }
  .ftr__contact li:last-child { padding-block: 0.35rem; color: var(--on-dark-mute); }
  .ftr__social { display: flex; gap: 0.5rem; margin-top: 1rem; }
  .ftr__social a { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 1px solid var(--line-dark); border-radius: var(--radius); transition: background-color var(--dur-1), border-color var(--dur-1); }
  .ftr__social a:hover { background: var(--brick); border-color: var(--brick); }
  .ftr__social svg { width: 1.15rem; height: 1.15rem; }
  .ftr__base { margin-top: clamp(3rem, 6vw, 5rem); padding-block: 1.5rem 2rem; border-top: 1px solid var(--line-dark); display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; justify-content: space-between; align-items: center; font-size: var(--fs-small); color: var(--on-dark-mute); }
  .ftr__top { min-height: 2.75rem; color: var(--on-dark); }
  .ftr__top:hover { color: var(--brick-lit); }
  @media (min-width: 56rem) {
    .ftr__in { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: start; }
    .ftr__cols { grid-template-columns: minmax(0, 3fr) minmax(0, 3fr) minmax(0, 5fr); }
    .ftr__cols > div:last-child { grid-column: auto; }
  }
</style>
