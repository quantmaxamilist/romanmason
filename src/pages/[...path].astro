---
// Blog posts keep their exact old WordPress paths: /YYYY/MM/DD/slug
import Base from '../layouts/Base.astro';
import PageHero from '../components/kit/PageHero.astro';
import Enquiry from '../components/kit/Enquiry.astro';
import Arrow from '../components/kit/Arrow.astro';
import { site } from '../data/site';
import posts from '../data/posts.json';

export function getStaticPaths() {
  return posts.map((post, i) => ({ params: { path: post.path }, props: { post, more: [1, 2, 3].map((n) => posts[(i + n) % posts.length]) } }));
}
const { post, more } = Astro.props;
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.date,
  dateModified: post.modified || post.date,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: `${site.url}/${post.path}`,
};
---
<Base title={post.seoTitle} description={post.description} type="article" published={post.date} modified={post.modified}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(article)} />
  <PageHero title={post.title} compact>
    <p class="label mute"><a class="po__back" href="/blog">Blog</a><span aria-hidden="true"> / </span>{post.category}<span aria-hidden="true"> · </span><time datetime={post.date.slice(0, 10)}>{post.dateText}</time></p>
  </PageHero>

  <article class="po is-light section section--tight" data-header-theme="light">
    <div class="wrap po__in">
      <div class="prose" set:html={post.html} />
      <aside class="po__side">
        <div class="po__card">
          <p class="label eyebrow">Get In Touch</p>
          <a class="po__tel" href={site.phoneHref}>{site.phone}</a>
          <a class="po__mail" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="btn" href="/contact">Get A Quote<Arrow class="btn__arrow" /></a>
        </div>
      </aside>
    </div>
  </article>

  <section class="mo is-stone section section--tight" data-header-theme="light">
    <div class="wrap">
      <p class="label eyebrow">More from the blog</p>
      <ul class="mo__list">
        {more.map((m) => (
          <li><a href={`/${m.path}`}><span class="label mo__d">{m.dateText}</span><span class="mo__t">{m.title}</span><Arrow class="mo__a" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Enquiry />
</Base>

<style>
  .po__back { text-decoration: underline; text-underline-offset: 0.25em; }
  .po__back:hover { color: var(--brick-lit); }
  .po__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; }
  .po__card { display: grid; gap: 0.9rem; justify-items: start; padding: 1.75rem; border: 1px solid var(--line-light); border-radius: var(--radius); background: var(--white); }
  .po__tel { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; letter-spacing: 0.04em; line-height: 1.1; }
  .po__tel:hover { color: var(--brick); }
  .po__mail { font-size: 0.9rem; color: var(--on-light-mute); overflow-wrap: anywhere; margin-bottom: 0.5rem; }
  @media (min-width: 68rem) {
    .po__in { grid-template-columns: minmax(0, 44rem) minmax(0, 20rem); justify-content: space-between; align-items: start; }
    .po__side { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
  .mo__list { margin-top: 1.5rem; }
  .mo__list li { border-top: 1px solid var(--line-light); }
  .mo__list li:last-child { border-bottom: 1px solid var(--line-light); }
  .mo__list a { position: relative; display: grid; gap: 0.4rem; padding: 1.35rem 2.25rem 1.35rem 0; }
  .mo__d { color: var(--on-light-mute); }
  .mo__t { font-size: 1.15rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; max-width: 52ch; }
  .mo__list :global(.mo__a) { position: absolute; right: 0.25rem; top: 50%; translate: 0 -50%; width: 1rem; height: 1rem; transition: transform var(--dur-2) var(--ease-out); }
  .mo__list a:hover .mo__t { color: var(--brick); }
  .mo__list a:hover :global(.mo__a) { transform: translateX(5px); }
  @media (min-width: 56rem) { .mo__list a { grid-template-columns: 14rem minmax(0, 1fr); align-items: baseline; } }
</style>
