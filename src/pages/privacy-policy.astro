---
import Base from '../layouts/Base.astro';
import PageHero from '../components/kit/PageHero.astro';
import { seo } from '../data/site';
import legal from '../data/legal.json';
// Policy text is the old page's, word for word. Hard line breaks inside running sentences
// (an artefact of the policy generator) are joined so the text reads as paragraphs.
const html = legal['privacy-policy'].html.replace(/<p>([\s\S]*?)<\/p>/g, (m: string, inner: string) => (inner.replace(/<[^>]+>/g, '').length > 160 ? `<p>${inner.replace(/\s*<br>\s*/g, ' ')}</p>` : m));
---
<Base title={seo.privacy.title} description={seo.privacy.description}>
  <PageHero title="Privacy Policy" compact />
  <section class="is-light section section--tight" data-header-theme="light">
    <div class="wrap"><div class="prose" set:html={html} /></div>
  </section>
</Base>
