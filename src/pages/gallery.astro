---
import Base from '../layouts/Base.astro';
import PageHero from '../components/kit/PageHero.astro';
import Enquiry from '../components/kit/Enquiry.astro';
import { gallery, seo } from '../data/site';
import { work, feat } from '../data/extra';
// The five large photographs lead, then the 27 gallery photographs. All are the client's own.
const photos = [feat.kitchen, feat.render, feat.joists, feat.kitchenDetail, feat.roof, ...work];
---
<Base title={seo.gallery.title} description={seo.gallery.description}>
  <PageHero eyebrow={gallery.eyebrow} title={gallery.h1} lead={gallery.lead} />

  <section class="gl is-light section--tight section" data-header-theme="light">
    <div class="wrap">
      <p class="label gl__count mute">{photos.length} photographs</p>
      <ul class="gl__grid" data-gallery>
        {photos.map((p, i) => (
          <li class="gl__cell">
            <button class="photo gl__btn" type="button" data-i={i} data-full={`/media/photos/${p.id}.webp`} data-w={p.w} data-h={p.h} aria-label={`Open photo ${i + 1} of ${photos.length}: ${p.alt}`} style={`aspect-ratio:${p.w}/${p.h}`}>
              <img
                src={`/media/photos/${p.id}${p.id.startsWith('feat-') ? '-s' : ''}.webp`}
                srcset={p.id.startsWith('feat-') ? `/media/photos/${p.id}-s.webp 640w, /media/photos/${p.id}-m.webp 1100w` : `/media/photos/${p.id}-s.webp 480w, /media/photos/${p.id}.webp ${p.w}w`}
                sizes="(min-width: 75rem) 22vw, (min-width: 48rem) 30vw, 46vw"
                width={p.w} height={p.h} alt={p.alt} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lb" id="lb" aria-label="Photo viewer">
    <div class="lb__stage"><img class="lb__img" alt="" /></div>
    <div class="lb__bar">
      <p class="label lb__n" aria-live="polite"></p>
      <div class="lb__ctl">
        <button class="lb__b" type="button" data-lb="prev" aria-label="Previous photo"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 8H2M6.500 3.500 2 8l4.500 4.500"/></svg></button>
        <button class="lb__b" type="button" data-lb="next" aria-label="Next photo"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 8h13M9.500 3.500 14 8l-4.500 4.500"/></svg></button>
        <button class="lb__b lb__close label" type="button" data-lb="close">Close</button>
      </div>
    </div>
  </dialog>

  <Enquiry />
</Base>

<style>
  .gl__count { margin-bottom: 1.5rem; }
  /* Columns keep every photo at its own shape; tiles never exceed the photo's native width. */
  .gl__grid { columns: 2; column-gap: clamp(0.5rem, 1.2vw, 1rem); }
  .gl__cell { break-inside: avoid; margin-bottom: clamp(0.5rem, 1.2vw, 1rem); }
  .gl__btn { display: block; width: 100%; cursor: zoom-in; }
  .gl__btn img { transition: transform 1.1s var(--ease-out); }
  .gl__btn:hover img, .gl__btn:focus-visible img { transform: scale(1.04); }
  @media (min-width: 48rem) { .gl__grid { columns: 3; } }
  @media (min-width: 75rem) { .gl__grid { columns: 4; } }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(13, 12, 11, 0.97); color: var(--on-dark); }
  .lb::backdrop { background: var(--ink); }
  .lb[open] { display: grid; grid-template-rows: minmax(0, 1fr) auto; }
  .lb__stage { display: grid; place-items: center; padding: clamp(1rem, 3vw, 2.5rem); min-height: 0; }
  .lb__img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: var(--radius); }
  .lb__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem var(--gutter) max(0.75rem, env(safe-area-inset-bottom)); border-top: 1px solid var(--line-dark); }
  .lb__ctl { display: flex; align-items: center; gap: 0.25rem; }
  .lb__b { min-width: 2.75rem; min-height: 2.75rem; display: grid; place-items: center; padding-inline: 0.75rem; border-radius: var(--radius); }
  .lb__b:hover { color: var(--brick-lit); }
  .lb__b svg { width: 1.1rem; height: 1.1rem; }
</style>

<script>
  import { lenis } from '../scripts/core.js';
  const grid = document.querySelector('[data-gallery]');
  const lb = document.getElementById('lb');
  if (grid && lb) {
    const btns = [...grid.querySelectorAll('.gl__btn')];
    const img = lb.querySelector('.lb__img');
    const count = lb.querySelector('.lb__n');
    let i = 0;
    let opener = null;
    const show = (n) => {
      i = (n + btns.length) % btns.length;
      const b = btns[i];
      // Never larger than the photograph really is.
      img.style.maxWidth = `min(100%, ${b.dataset.w}px)`;
      img.width = +b.dataset.w; img.height = +b.dataset.h;
      img.src = b.dataset.full;
      img.alt = b.querySelector('img').alt;
      count.textContent = `Photo ${i + 1} of ${btns.length}`;
    };
    const close = () => { if (lb.open) lb.close(); lenis?.start(); document.body.style.overflow = ''; opener?.focus(); };
    btns.forEach((b, n) => b.addEventListener('click', () => { opener = b; show(n); lb.showModal(); lenis?.stop(); document.body.style.overflow = 'hidden'; }));
    lb.addEventListener('click', (e) => {
      const act = e.target.closest('[data-lb]')?.dataset.lb;
      if (act === 'prev') show(i - 1);
      else if (act === 'next') show(i + 1);
      else if (act === 'close' || e.target === lb || e.target.classList.contains('lb__stage')) close();
    });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      else if (e.key === 'ArrowRight') show(i + 1);
    });
    // Escape closes the dialog natively; make sure scrolling comes back on every close path.
    lb.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    lb.addEventListener('close', () => { lenis?.start(); document.body.style.overflow = ''; });
  }
</script>
