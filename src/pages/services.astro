---
import Base from '../layouts/Base.astro';
import PageHero from '../components/kit/PageHero.astro';
import Enquiry from '../components/kit/Enquiry.astro';
import Img from '../components/kit/Img.astro';
import Arrow from '../components/kit/Arrow.astro';
import { services, servicesPage as sp, seo } from '../data/site';
import { feat, work } from '../data/extra';
import posts from '../data/posts.json';
const photoOf = (id?: string) => (id ? (Object.values(feat).find((p) => p.id === id) ?? work.find((p) => p.id === id)) : undefined);
const postOf = (path: string) => posts.find((p) => p.path === path);
const ind = sp.industries;
---
<Base title={seo.services.title} description={seo.services.description}>
  <PageHero eyebrow={sp.eyebrow} title={sp.h1} lead={sp.lead} photo={feat.joists} />

  <section class="sv is-light" data-header-theme="light">
    <div class="wrap">
      {services.map((s, i) => {
        const photo = photoOf(s.photo);
        const post = s.post ? postOf(s.post) : undefined;
        return (
          <article class:list={['sv__row', { 'sv__row--flip': i % 2 === 1 }]} id={s.slug}>
            <div class="sv__text">
              <span class="sv__n numeral" aria-hidden="true">{s.numeral}</span>
              <h2 class="display display--2 sv__h" data-reveal="lines">{s.name}</h2>
              <p class="lead sv__p" data-reveal="fade">{s.body}</p>
              <div class="sv__act" data-reveal="fade">
                <a class="btn" href={`/contact?service=${s.slug}`}>Get A Quote<Arrow class="btn__arrow" /></a>
                {post && <a class="link" href={`/${post.path}`}>Read the guide<Arrow /></a>}
              </div>
            </div>
            {photo ? (
              <figure class:list={['photo sv__photo', { 'sv__photo--tall': photo.h > photo.w }]} data-reveal="photo">
                <Img {...photo} sizes="(min-width: 62rem) 40vw, 92vw" />
              </figure>
            ) : (
              <div class="sv__mark" data-reveal="fade" aria-hidden="true"><img src="/brand/icon.svg" width="200" height="200" alt="" loading="lazy" /></div>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="ind is-dark section" data-header-theme="dark">
    <div class="wrap ind__in">
      <div class="ind__head">
        <p class="label eyebrow" data-reveal="fade">{ind.eyebrow}</p>
        <h2 class="display display--2 ind__h" data-reveal="lines">{ind.h2}</h2>
        <p class="lead mute" data-reveal="fade">{ind.intro}</p>
      </div>
      <div class="ind__body">
        <ul class="ind__list">
          {ind.sectors.map((sec, i) => (
            <li class="ind__item" data-reveal="fade">
              <span class="numeral ind__n" aria-hidden="true">{['I', 'II', 'III'][i]}</span>
              <div><h3 class="ind__t">{sec.name}</h3><p class="mute">{sec.body}</p></div>
            </li>
          ))}
        </ul>
        <p class="ind__dom" data-reveal="fade">{ind.domestic}</p>
      </div>
    </div>
  </section>

  <Enquiry />
</Base>

<style>
  .sv__row { display: grid; gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(3.5rem, 8vw, 7rem); border-top: 1px solid var(--line-light); scroll-margin-top: var(--header-h); }
  .sv__row:first-child { border-top: 0; }
  .sv__text { display: grid; gap: 1.25rem; justify-items: start; align-content: center; }
  .sv__n { color: var(--brick); font-size: var(--fs-display-3); line-height: 1; }
  .sv__h { max-width: 16ch; }
  .sv__p { max-width: 48ch; color: var(--on-light-mute); }
  .sv__act { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 0.75rem; }
  .sv__photo { aspect-ratio: 3 / 2; }
  .sv__photo--tall { aspect-ratio: 4 / 5; max-width: 30rem; }
  .sv__mark { aspect-ratio: 3 / 2; display: grid; place-items: center; background: var(--ink); border-radius: var(--radius); }
  .sv__mark img { width: min(46%, 15rem); height: auto; }
  @media (min-width: 62rem) {
    .sv__row { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; column-gap: clamp(3rem, 8vw, 8rem); }
    .sv__row--flip .sv__text { order: 2; }
    .sv__row--flip { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
    .sv__photo--tall { justify-self: center; width: 100%; }
  }

  .ind__in { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }
  .ind__head { display: grid; gap: 1.5rem; align-content: start; }
  .ind__h { max-width: 16ch; }
  .ind__item { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.5rem; padding-block: 1.6rem; border-top: 1px solid var(--line-dark); }
  .ind__item:last-child { border-bottom: 1px solid var(--line-dark); }
  .ind__n { color: var(--brick-lit); font-size: 0.95rem; padding-top: 0.3rem; }
  .ind__t { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: var(--track-display); font-size: clamp(1.1rem, 0.95rem + 0.55vw, 1.4rem); line-height: 1.15; margin-bottom: 0.5rem; }
  .ind__dom { margin-top: 2rem; max-width: 60ch; color: rgba(244, 242, 237, 0.86); }
  @media (min-width: 62rem) {
    .ind__in { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: clamp(3rem, 8vw, 8rem); }
    .ind__head { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>
